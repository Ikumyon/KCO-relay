import { ScrollView } from "std-widgets.slint";

// 全画面で共有するテーマ定義。個別コンポーネントへ色を持たせない。
export global Theme {
    in-out property <bool> dark_mode: false;
    out property <length> caption-height: 32px;
    out property <color> window: dark_mode ? #202020 : #f3f6fb;
    out property <color> surface: dark_mode ? #2b2b2b : #ffffff;
    out property <color> inset: dark_mode ? #1f1f1f : #f8fafc;
    out property <color> border: dark_mode ? #383838 : #d8e0ea;
    out property <color> control-border: dark_mode ? #3f3f3f : #cbd5e1;
    out property <color> text: dark_mode ? #ffffff : #172033;
    out property <color> muted: dark_mode ? #888888 : #64748b;
    out property <color> accent: dark_mode ? #60cdff : #0078d4;
    out property <color> button: dark_mode ? #323232 : #f8fafc;
    out property <color> button-hover: dark_mode ? #383838 : #e6edf5;
    out property <color> button-text: dark_mode ? #cccccc : #334155;
    out property <color> title-text: dark_mode ? #d1d5db : #172033;
    out property <color> terminal: dark_mode ? #181818 : #0f172a;
    out property <color> terminal-border: dark_mode ? #262626 : #1e293b;
    out property <color> terminal-text: dark_mode ? #cccccc : #dbeafe;
}

// ============================================================================
// 設定サブウィンドウ (Settings Window) - Windows 11 Fluent Design Style
// ============================================================================
export component SettingsWindow inherits Window {
    title: "設定 (Settings)";
    icon: @image-url("../icons/icon.ico");
    width: 350px;
    height: 286px + (root.save_error != "" ? 48px : 0px);
    in property <string> save_error;
    in-out property <int> theme_mode: 0;
    background: Theme.window;
    default-font-family: "Segoe UI";

    in-out property <string> log_days_str: "10";
    in-out property <string> db_days_str: "10";

    callback step_log_days(int);
    callback step_db_days(int);
    callback save_settings(string, string, int);
    callback cancel_settings();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Rectangle {
            background: Theme.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            height: 42px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 6px;
                cross-axis-alignment: center;
                Text { text: "テーマ"; color: Theme.text; font-size: 13px; horizontal-stretch: 1; vertical-alignment: center; }
                for option[index] in ["OSに合わせる", "ライト", "ダーク"] : Rectangle {
                    width: option == "OSに合わせる" ? 82px : 52px;
                    height: 26px;
                    border-radius: 4px;
                    background: root.theme_mode == index ? Theme.accent : Theme.button;
                    border-width: 1px;
                    border-color: root.theme_mode == index ? Theme.accent : Theme.control-border;
                    TouchArea { clicked => { root.theme_mode = index; } }
                    Text { text: option; color: root.theme_mode == index ? #ffffff : Theme.text; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // 1. ログ保存期間カード
        Rectangle {
            background: Theme.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            height: 52px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: center;
                spacing: 10px;
                cross-axis-alignment: center;

                Text {
                    text: "ログ保存期間";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // マイナスボタン
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: btn_log_minus.has-hover ? Theme.button-hover : Theme.button;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.control-border;

                    btn_log_minus := TouchArea {
                        clicked => { root.step_log_days(-1); }
                    }
                    Text {
                        text: "-";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 数値入力ボックス
                Rectangle {
                    width: 48px;
                    height: 28px;
                    background: Theme.inset;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: inp_log.has-focus ? Theme.accent : Theme.control-border;

                    HorizontalLayout {
                        padding-left: 2px;
                        padding-right: 2px;
                        alignment: center;

                        inp_log := TextInput {
                            text: root.log_days_str;
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            input-type: number;
                            edited => { root.log_days_str = self.text; }
                        }
                    }
                }

                // プラスボタン
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: btn_log_plus.has-hover ? Theme.button-hover : Theme.button;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.control-border;

                    btn_log_plus := TouchArea {
                        clicked => { root.step_log_days(1); }
                    }
                    Text {
                        text: "+";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "日";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        // 2. DBデータ保存期間カード
        Rectangle {
            background: Theme.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            height: 52px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                alignment: center;
                spacing: 10px;
                cross-axis-alignment: center;

                Text {
                    text: "DB保存期間";
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // マイナスボタン
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: btn_db_minus.has-hover ? Theme.button-hover : Theme.button;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.control-border;

                    btn_db_minus := TouchArea {
                        clicked => { root.step_db_days(-1); }
                    }
                    Text {
                        text: "-";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // 数値入力ボックス
                Rectangle {
                    width: 48px;
                    height: 28px;
                    background: Theme.inset;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: inp_db.has-focus ? Theme.accent : Theme.control-border;

                    HorizontalLayout {
                        padding-left: 2px;
                        padding-right: 2px;
                        alignment: center;

                        inp_db := TextInput {
                            text: root.db_days_str;
                            color: Theme.accent;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            input-type: number;
                            edited => { root.db_days_str = self.text; }
                        }
                    }
                }

                // プラスボタン
                Rectangle {
                    width: 28px;
                    height: 28px;
                    background: btn_db_plus.has-hover ? Theme.button-hover : Theme.button;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.control-border;

                    btn_db_plus := TouchArea {
                        clicked => { root.step_db_days(1); }
                    }
                    Text {
                        text: "+";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "日";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        if root.save_error != "" : Text {
            text: root.save_error;
            color: Theme.text;
            font-size: 11px;
            wrap: word-wrap;
            height: 36px;
        }

        // フッター操作ボタン（キャンセル & 保存）
        HorizontalLayout {
            spacing: 10px;
            height: 32px;

            // キャンセルボタン
            Rectangle {
                background: btn_cancel.has-hover ? Theme.button-hover : Theme.button;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.control-border;
                horizontal-stretch: 1;

                btn_cancel := TouchArea {
                    clicked => { root.cancel_settings(); }
                }
                Text {
                    text: "キャンセル";
                    color: Theme.button-text;
                    font-size: 12px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 保存ボタン（Windows 11 Accent Primary）
            Rectangle {
                background: btn_save.has-hover ? #005ba8 : #0078d4;
                border-radius: 5px;
                horizontal-stretch: 1;

                btn_save := TouchArea {
                    clicked => {
                        root.save_settings(root.log_days_str, root.db_days_str, root.theme_mode);
                    }
                }
                Text {
                    text: "設定を保存";
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// タイトルバーの操作ボタン。サイズ・アイコン配置・ホバー表示を共有する。
component CaptionButton inherits Rectangle {
    in property <image> icon;
    in property <bool> is-close: false;
    callback clicked();

    width: 46px;
    height: Theme.caption-height;
    background: touch.has-hover ? (root.is-close ? #c42b1c : Theme.button-hover) : transparent;

    Image {
        source: root.icon;
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: touch.has-hover ? (root.is-close ? #ffffff : Theme.text) : Theme.muted;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ============================================================================
// メインウィンドウ (Main Window) - Windows 11 Fluent Design Style
// ============================================================================
export component AppWindow inherits Window {
    title: "KCO Relay Server";
    icon: @image-url("../icons/icon.ico");
    no-frame: true;
    min-width: 480px;
    min-height: 480px;
    preferred-width: 500px;
    preferred-height: 530px;
    background: Theme.window;
    default-font-family: "Segoe UI";

    in-out property <string> status_in: "5000: Input (起動中)";
    in-out property <color> status_in_color: #eab308;
    in-out property <string> status_out: "5001: Output (起動中)";
    in-out property <color> status_out_color: #eab308;

    in-out property <string> schema_text: "-";
    in-out property <string> updated_text: "-";
    in-out property <string> ts_text: "-";
    in-out property <string> current_title: "待機中...";
    in-out property <string> log_text: "";

    callback open_settings();
    callback minimize_window();
    callback minimize_to_tray();
    callback toggle_maximize();
    callback quit_app();
    callback drag_window(length, length);

    property <length> drag_start_x;
    property <length> drag_start_y;

    // Windows の表示領域も同じ半径 8px に切り抜く。最大化時は両方を四角に戻す。
    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
        border-radius: root.maximized ? 0px : 8px;
        clip: true;

        VerticalLayout {
            // ================================================================
            // 1. タイトルバー (Windows 11 Fluent Caption Bar)
            // ================================================================
            Rectangle {
                height: Theme.caption-height;
                background: Theme.surface;

                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: 0px;
                    spacing: 0px;

                    // 名前欄と余白が残りの幅を占め、その全体をドラッグ領域にする。
                    Rectangle {
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 12px;
                            spacing: 6px;
                            cross-axis-alignment: center;

                            Image {
                                source: @image-url("../icons/icon_32.png");
                                width: 16px;
                                height: 16px;
                            }

                            Text {
                                text: root.title;
                                color: Theme.title-text;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }

                            Rectangle { horizontal-stretch: 1; }
                        }

                        TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down) {
                                    root.drag_start_x = self.mouse-x;
                                    root.drag_start_y = self.mouse-y;
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.drag_window(self.mouse-x - root.drag_start_x, self.mouse-y - root.drag_start_y);
                                }
                            }
                        }
                    }

                    // 固定幅の5ボタンを隙間なく右端へ並べる。
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        padding: 0px;
                        spacing: 0px;

                        CaptionButton {
                            icon: @image-url("../icons/settings.svg");
                            clicked => { root.open_settings(); }
                        }
                        CaptionButton {
                            icon: @image-url("../icons/tray-arrow-down-thin.svg");
                            clicked => { root.minimize_to_tray(); }
                        }
                        CaptionButton {
                            icon: @image-url("../icons/minus.svg");
                            clicked => { root.minimize_window(); }
                        }
                        CaptionButton {
                            icon: @image-url("../icons/expand.svg");
                            clicked => { root.toggle_maximize(); }
                        }
                        CaptionButton {
                            icon: @image-url("../icons/x.svg");
                            is-close: true;
                            clicked => { root.quit_app(); }
                        }
                    }
                }
            }

            // タイトルバー下ディバイダー
            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // ================================================================
            // 2. メインコンテンツ領域
            // ================================================================
            VerticalLayout {
                padding: 14px;
                spacing: 12px;
                vertical-stretch: 1;

                // --- 稼働状態インジケーター (Pill Badges) ---
                HorizontalLayout {
                    spacing: 10px;
                    height: 36px;

                    // Input サーバーバッジ
                    Rectangle {
                        background: Theme.surface;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            alignment: center;
                            cross-axis-alignment: center;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.status_in_color;
                            }

                            Text {
                                text: root.status_in;
                                color: Theme.text;
                                font-size: 11px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    // Output サーバーバッジ
                    Rectangle {
                        background: Theme.surface;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            alignment: center;
                            cross-axis-alignment: center;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.status_out_color;
                            }

                            Text {
                                text: root.status_out;
                                color: Theme.text;
                                font-size: 11px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                // --- Now Playing メディアカード (Win11 Media Player Style) ---
                Rectangle {
                    background: Theme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        // カードヘッダー
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Image {
                                source: @image-url("../icons/play.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.accent;
                            }

                            Text {
                                text: "再生中";
                                color: Theme.accent;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: root.updated_text;
                                color: Theme.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        // 再生タイトル表示エリア (左側アクセントバー付きインセット)
                        Rectangle {
                            background: Theme.inset;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;
                            min-height: 52px;

                            HorizontalLayout {
                                // 左端の Win11 アクセントバー
                                Rectangle {
                                    width: 3px;
                                    background: #0078d4;
                                    border-top-left-radius: 6px;
                                    border-bottom-left-radius: 6px;
                                }

                                VerticalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;

                                    Text {
                                        text: root.current_title;
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // メタ情報行 (Schema & TS)
                        HorizontalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: "Schema:"; color: Theme.muted; font-size: 11px; font-weight: 500; }
                                Text { text: root.schema_text; color: Theme.button-text; font-size: 11px; }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                Text { text: "TS:"; color: Theme.muted; font-size: 11px; font-weight: 500; }
                                Text { text: root.ts_text; color: Theme.button-text; font-size: 11px; }
                            }
                        }
                    }
                }

                // --- アクティビティログコンソール (Win11 Terminal Style) ---
                Rectangle {
                    background: Theme.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        // コンソールヘッダー
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Image {
                                source: @image-url("../icons/square-terminal.svg");
                                width: 12px;
                                height: 12px;
                                colorize: Theme.muted;
                            }

                            Text {
                                text: "アクティビティログ";
                                color: Theme.muted;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        // ターミナルブラック画面
                        Rectangle {
                            background: Theme.terminal;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.terminal-border;

                            ScrollView {
                                Text {
                                    text: root.log_text;
                                    color: Theme.terminal-text;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                    width: parent.width;
                                    height: parent.height;
                                    horizontal-alignment: left;
                                    vertical-alignment: top;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
